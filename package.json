{
  "name": "imya-rozy-atlas",
  "version": "1.0.0",
  "description": "Имя розы — атлас тайн аббатства",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "preview:cf": "npm run build && npx --yes wrangler@4 pages dev dist --port 8788",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:dist": "node scripts/verify-dist.mjs dist",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:dist"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.0.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  }
}
